{
  "redirects": [
    {
      "source": "/bsc",
      "destination": "/bnb-smart-chain",
      "statusCode": 301
    },
    {
      "source": "/bsc/:path*",
      "destination": "/bnb-smart-chain",
      "statusCode": 301
    },
    {
      "source": "/faq",
      "destination": "/faqs",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/guides/top-cross-chain-bridges",
      "destination": "/guides/top-cross-chain-bridges/index.html"
    },
    {
      "source": "/guides/top-cross-chain-bridges/(.*)",
      "destination": "/guides/top-cross-chain-bridges/index.html"
    },
    {
      "source": "/:slug(about|guides|faqs|contact|megaeth|monad|citrea|arbitrum|ethereum|polygon|base|optimism|op-mainnet|scroll|kaia|bnb-smart-chain|hyperevm|avalanche)",
      "destination": "/:slug/index.html"
    },
    {
      "source": "/:slug(about|guides|faqs|contact|megaeth|monad|citrea|arbitrum|ethereum|polygon|base|optimism|op-mainnet|scroll|kaia|bnb-smart-chain|hyperevm|avalanche)/(.*)",
      "destination": "/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/landing-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/landing-scripts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
