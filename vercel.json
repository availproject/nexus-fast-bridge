{
  "rewrites": [
    {
      "source": "/(multi-chain-crypto-bridge|fastbridge|best-cross-chain-bridge-2026)\\.html",
      "destination": "/$1.html"
    },
    {
      "source": "/:slug(megaeth|monad|citrea)",
      "destination": "/:slug/index.html"
    },
    {
      "source": "/:slug(megaeth|monad|citrea)/(.*)",
      "destination": "/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/landing-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/landing-scripts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
