{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "overrides": [
    {
      "includes": ["packages/fast-bridge-app/src/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useAriaPropsForRole": "warn",
            "useFocusableInteractive": "warn",
            "useSemanticElements": "warn"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "warn",
            "noForEach": "warn",
            "noVoid": "warn"
          },
          "correctness": {
            "useExhaustiveDependencies": "warn",
            "useImageSize": "warn"
          },
          "performance": {
            "noBarrelFile": "warn",
            "noNamespaceImport": "warn",
            "useTopLevelRegex": "warn"
          },
          "style": {
            "useConsistentArrayType": "warn",
            "useConsistentTypeDefinitions": "warn",
            "noEnum": "warn",
            "noNestedTernary": "warn",
            "noNonNullAssertion": "warn",
            "useFilenamingConvention": "warn"
          },
          "suspicious": {
            "noArrayIndexKey": "warn",
            "useIterableCallbackReturn": "warn"
          }
        }
      }
    },
    {
      "includes": ["public/landing-scripts/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noForEach": "off"
          },
          "style": {
            "useForOf": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/fast-bridge-app/src/components/landing-page/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useButtonType": "off"
          },
          "correctness": {
            "useImageSize": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          },
          "complexity": {
            "noForEach": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/fast-bridge-app/src/components/nexus-one/**",
        "packages/fast-bridge-app/src/components/swaps/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useButtonType": "off",
            "noNoninteractiveElementInteractions": "off",
            "noNoninteractiveTabindex": "off",
            "useAriaPropsSupportedByRole": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useAltText": "off",
            "noSvgWithoutTitle": "off"
          },
          "correctness": {
            "noUnusedFunctionParameters": "off",
            "useImageSize": "off",
            "noUnusedVariables": "off",
            "useHookAtTopLevel": "off",
            "useExhaustiveDependencies": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noBitwiseOperators": "off",
            "noEmptyBlockStatements": "off",
            "useAwait": "off",
            "useNumberToFixedDigitsArgument": "off",
            "noGlobalIsNan": "off"
          },
          "style": {
            "noNestedTernary": "off",
            "noNonNullAssertion": "off",
            "useFilenamingConvention": "off",
            "useConsistentTypeDefinitions": "off",
            "useTemplate": "off",
            "useAtIndex": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noVoid": "off",
            "useOptionalChain": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}
