# WalletConnect / Reown Project ID
VITE_WALLET_CONNECT_ID=

# Nexus SDK Configuration (network fallback: mainnet, channel fallback: stable)
VITE_CONFIG_NEXUS_NETWORK=mainnet
VITE_CONFIG_NEXUS_CHANNEL=stable
VITE_CONFIG_NEXUS_SUPPORTED_CHAIN=
VITE_CONFIG_NEXUS_PRIMARY_TOKEN=

# Cloudflare Turnstile Configuration
VITE_TURNSTILE_SITE_KEY=

# Maintenance mode: set to true to display maintenance banner and hide input box on app pages
VITE_IS_APP_DOWN=false
